<%- include('../layouts/header') %>
    <!-- Page Heading -->
    <h1 class="h3 mb-4 text-gray-800">Update Our Insights</h1>

    <div class="col-lg-6" style="padding-right: 0;
padding-left: 0;">

        <!-- Circle Buttons -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"></h6>
            </div>
            <div class="card-body">
                <form id="insights" method="post" action="/admin/ourinsights/updateInsights" enctype='multipart/form-data' >
                    <input type="hidden" name="id" value="<%= insightId._id %>">

                    <div class="form-group">
                        <label>Title : </label>
                        <input type="text" class="form-control" id="title" name="title"
                            placeholder="Enter Insights Title" value="<%= insightId.title %>">
                    </div>
                    <div class="form-group">
                        <label>Upload Image : </label>
                        <input type="file" style="line-height: 1.15;" class="form-control" id="image" name="image"
                            accept="image/jpg, image/jpeg, image/png">
                        <img src="<%= process.env._APP_URL_ADMIN %>/<%= insightId.image %>" alt="image" class="mt-3" height="80">
                    </div>
                    <div class="form-group">
                        <label>Description : </label>
                        <textarea class="form-control" id="description" name="description" placeholder="Enter Insights Description" rows="6"
                            cols="33"><%= insightId.description %></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Submit</button>
                </form>
            </div>
        </div>


    </div>

    <script src="/admin/vendor/jquery/jquery.min.js"></script>

    <script>
        $('#pageTitle').text('Update Our Insights')
        $('#select-insights').addClass('active', 'true');

        $(document).ready(function () {
            jQuery.validator.addMethod("noSpace", function (value, element) {
                return value == '' || value.trim().length != 0;
            }, "No space please and don't leave it empty");

            $("#insights").validate({
                rules: {
                    title: {
                        required: true,
                        noSpace: true
                    },
                    description: {
                        required: true,
                        noSpace: true
                    },
                },
                messages: {
                    title: {
                        required: "Title is required"
                    },
                    description: {
                        required: "Description is required",
                    },
                },
                submitHandler: function (form) {
                    form.submit();
                }
            })
        })
    </script>


    <%- include('../layouts/footer') %>