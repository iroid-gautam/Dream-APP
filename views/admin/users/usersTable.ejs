<%- include('../layouts/header') %>

<!-- Page Heading -->
<h1 class="h3 mb-2 text-gray-800">Users</h1>

<!-- DataTales Example -->
<div class="card shadow mb-3">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="userTable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Joining Date</th>
                        <th>Profile</th>
                        <!-- <th>Action</th> -->
                    </tr>
                </thead>
                <tbody>


                </tbody>
            </table>
        </div>
    </div>
</div>


<script src="/admin/vendor/jquery/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>

<script>
    $("#success").show().delay(2000).fadeOut();
    $("#error").show().delay(2000).fadeOut();
    $('#pageTitle').text('Users')
    $('#select-users').addClass('active', 'true')

    $(document).ready(function () {
        $('#userTable').DataTable({
            paging: true,
            responsive: true,
            searching: true,
            processing: true,
            serverSide: true,
            ordering: false,
            ajax: {
                url: "<%= process.env.APP_URL_ADMIN %>/admin/user/viewUser",
                type: "GET",
            },
            columns: [
                {
                    "data": "id",
                    "render": function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                {
                    "data": "name",
                    "render": function (data, type, row) {
                        return data != "" ? data : null
                    }
                },
                {
                    "data": "email",
                    "render": function (data, type, row) {
                        return data != "" ? data : null
                    }
                },
                {
                    "data": "created_at",
                    "render": function (data, type, row) {
                        return data != null ? moment(data).format('DD-MM-YYYY') : null
                    }
                },
                {
                    "data": "profileImage",
                    "render": function (data) {
                        return data == null ? `<img src="${'<%= process.env.APP_URL_ADMIN %>'}/admin/img/profile.png" height="40"/>` : `<img src="${'<%= process.env.APP_URL_ADMIN %>'}/${data}" style="border-radius: 100%; height: 2.5rem;width: 2.5rem;" height="40"/>`
                    }
                },
                // {
                //     "data": null,
                //     "render": function (data) {
                //         return `<a href="/admin/user/removeUser/${data._id}" onclick="deleteRecord(event)" class="btn btn-danger btn-circle"><i class="fas fa-trash"></i></a>`
                //     }
                // },
            ],
        });
    });



    function deleteRecord(ev) {
      ev.preventDefault();
      var id = ev.currentTarget.getAttribute('href');
      // console.log(id);
      swal({
        title: "Are you sure you want to delete this user?",
        icon: "warning",
        buttons: true,
        dangerMode: true,
      })
        .then((willDelete) => {
          if (willDelete) {
            $.ajax({
              url: id,
              type: 'GET',
              success: function (d) {
                swal({
                  title: "User deleted successfully",
                  icon: "success",
                });
                $('#userTable').DataTable().ajax.reload();
              }
            });
          }
        }).catch(err => console.log(err))
    }
</script>

<%- include('../layouts/footer') %>