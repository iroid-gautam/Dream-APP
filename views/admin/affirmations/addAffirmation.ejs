<%- include('../layouts/header') %>
    <!-- Page Heading -->
    <h1 class="h3 mb-4 text-gray-800">Add Affirmations</h1>

    <div class="col-lg-6" style="padding-right: 0;
padding-left: 0;">

        <!-- Circle Buttons -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"></h6>
                <% if(success !='' ){ %>
                    <div class="alert alert-success" style="margin-bottom: 0;" id="error">
                        <%= success %>
                    </div>
                    <% } %>
                        <% if(error !='' ){ %>
                            <div class="alert alert-danger" style="margin-bottom: 0;" id="error">
                                <%= error %>
                            </div>
                            <% } %>
            </div>
            <div class="card-body">
                <form id="inspirationalQ" method="post" enctype='multipart/form-data'>
                    <div class="form-row">
                        <div class="form-group col-md-5">
                            <label>Affirmations Type : </label>
                            <select id="type" name="type" class="form-control">
                                <option value="" selected>Select Type</option>
                                <option value="Clarity">Clarity</option>
                                <option value="Courage">Courage</option>
                                <option value="Activation">Activation</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Front Affirmations Image : </label>
                        <input type="file" style="line-height: 1.15;" class="form-control"
                            id="frontImage" name="frontImage" accept="image/jpg, image/jpeg, image/png">
                        <!-- <input type="file" onchange="readURL(this);" style="line-height: 1.15;" class="form-control"
                            id="frontImage" name="frontImage" accept="image/jpg, image/jpeg, image/png"> -->
                        <!-- <img id="blah" src="#" alt="your image" style="display: none;" /> -->
                    </div>
                    <div class="form-group">
                        <label>Flip Affirmations Image : </label>
                        <input type="file" style="line-height: 1.15;" class="form-control" id="flipImage"
                            name="flipImage" accept="image/jpg, image/jpeg, image/png">
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Submit</button>
                </form>
            </div>
        </div>


    </div>

    <script src="/admin/vendor/jquery/jquery.min.js"></script>

    <script>
        $('#pageTitle').text('Add Affirmations')
        $('#select-Affirmation').addClass('active', 'true');


        // function readURL(input) {
        //     document.getElementById("blah").style.display = "block";
        //     if (input.files && input.files[0]) {
        //         var reader = new FileReader();

        //         reader.onload = function (e) {
        //             $('#blah').attr('src', e.target.result).width(140).height(110);
        //         };

        //         reader.readAsDataURL(input.files[0]);
        //     }
        // }

        $(document).ready(function () {

            jQuery.validator.addMethod("noSpace", function (value, element) {
                return value == '' || value.trim().length != 0;
            }, "No space please and don't leave it empty");

            $.validator.addMethod("imageExtension", function (value, element) {
                var allowedExtensions = ["jpg", "jpeg", "png", "gif"];
                var fileExtension = value.split('.').pop().toLowerCase();
                return $.inArray(fileExtension, allowedExtensions) !== -1;
            }, "Please select a valid image file (JPG, JPEG, PNG)");


            $("#inspirationalQ").validate({
                rules: {
                    type: {
                        required: true,
                    },
                    frontImage: {
                        required: true,
                        imageExtension: true
                    },
                    flipImage: {
                        required: true,
                        imageExtension: true
                    },
                },
                messages: {
                    type: {
                        required: "Please select type",
                    },
                    frontImage: {
                        required: "Front affirmation image is required",
                    },
                    flipImage: {
                        required: "Flip affirmation image is required",
                    },
                },
                submitHandler: function (form) {
                    form.submit();
                }
            })
        })
    </script>


    <%- include('../layouts/footer') %>