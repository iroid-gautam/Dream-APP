<%- include('../layouts/header') %>
    <!-- Page Heading -->
    <h1 class="h3 mb-4 text-gray-800">Update Videos & Podcasts</h1>

    <div class="col-lg-6" style="padding-right: 0;
padding-left: 0;">

        <!-- Circle Buttons -->
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"></h6>
                <% if(success !='' ){ %>
                    <div class="alert alert-success" style="margin-bottom: 0;" id="error">
                        <%= success %>
                    </div>
                    <% } %>
                        <% if(error !='' ){ %>
                            <div class="alert alert-danger" style="margin-bottom: 0;" id="error">
                                <%= error %>
                            </div>
                            <% } %>
            </div>
            <div class="card-body">
                <form id="videopodcast" method="post" enctype='multipart/form-data'>

                    <input type="hidden" name="id" value="<%= vidPod._id %>">

                    <div class="form-row">
                        <div class="form-group col-md-5">
                            <label>Videos & Podcasts Type : </label>
                            <select id="type" name="type" class="form-control">
                                <option value="" selected>Select Type</option>
                                <option value="1">Videos</option>
                                <option value="2">Podcasts</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Title : </label>
                        <input type="text" class="form-control" id="title" name="title"
                            placeholder="Enter Video & Podcasts Title" value="<%= vidPod.title %>">
                    </div>
                    <!-- <div class="form-group">
                        <label>Thumbnail Image : </label>
                        <input type="file" style="line-height: 1.15;" class="form-control" id="thumbnail"
                            name="thumbnail" accept="image/jpg, image/jpeg, image/png">
                    </div> -->
                    <div class="form-group">
                        <label>Upload Videos & Podcasts: </label>
                        <input type="file" style="line-height: 1.15;" class="form-control" id="videopodcast_file"
                            name="videopodcast" accept="video/*">
                        <video style="margin-top: 20px;" width="350" height="140" autoplay controls>
                            <source src="<%= process.env.APP_URL_ADMIN %>/<%= vidPod.videoPodcast %>">
                        </video>
                    </div>
                    <div class="form-group">
                        <label>Description : </label>
                        <textarea class="form-control" id="description" name="description"
                            placeholder="Enter Videos & Podcasts Description" rows="6"
                            cols="33"><%= vidPod.description %></textarea>
                    </div>
                    <button type="submit" id="submitbtn" class="btn btn-primary mt-3">Submit</button>
                </form>
            </div>
        </div>


    </div>

    <script src="/admin/vendor/jquery/jquery.min.js"></script>
    <script>
        $('#pageTitle').text('Videos & Podcasts')
        $('#select-vp').addClass('active', 'true');


        function getExtension(filename) {
            var parts = filename.split('.');
            return parts[parts.length - 1];
        }

        $("#submitbtn").click(function () {
            var vidExt = ['m4v', 'avi', 'mpg', 'mp4'];
            var audioExt = ['mp3', 'wav'];
            var ext = getExtension($('#videopodcast_file').val());

            if (!$('#type').val()) {
                Swal.fire('Please select video or podcast type')
                return false;
            }
            if ($('#type').val() == 1) {
                if (!(vidExt.includes(ext))) {
                    if (!$('#videopodcast_file').val()) {
                        Swal.fire('Video is required')
                        return false;
                    } else {
                        Swal.fire('Only video allowed')
                        return false;
                    }
                }

            } else if (!(vidExt.includes(ext)) && !(audioExt.includes(ext))) {
                if (!$('#videopodcast_file').val()) {
                    Swal.fire('Video is required')
                    return false;
                } else {
                    Swal.fire('Only video allowed')
                    return false;
                }
            }

            var input = document.getElementById('videopodcast_file');
            var file = input.files;

            var fileSize = Math.round((file[0].size / 1024));

            if (fileSize <= 50 * 1024) {
                return true;
            } else {
                Swal.fire('Video size upload only 50 MB');
                return false;
            }

            return true;
        });

        $(document).ready(function () {
            jQuery.validator.addMethod("noSpace", function (value, element) {
                return value == '' || value.trim().length != 0;
            }, "No space please and don't leave it empty");

            $.validator.addMethod('filesize', function (value, element, param) {
                return this.optional(element) || (element.files[0].size <= param)
            }, 'File size must be less than {0}');

            $("#videopodcast").validate({
                rules: {
                    title: {
                        required: true,
                        noSpace: true
                    },
                    thumbnail: {
                        required: true,
                    },
                    description: {
                        required: true,
                        noSpace: true
                    },
                    // type: {
                    //     required: true,
                    // },
                    // videopodcast: {
                    //     required: true,
                    // },
                },
                messages: {
                    title: {
                        required: "Title is required"
                    },
                    thumbnail: {
                        required: "Thumbnail image is required"
                    },
                    description: {
                        required: "Description is required",
                    },
                    // type: {
                    //     required: "Please select type",
                    // },
                    // videopodcast: {
                    //     required: "Video or podcasts is required",
                    // },
                },
                submitHandler: function (form) {
                    form.submit();
                }
            })
        })
    </script>


    <%- include('../layouts/footer') %>