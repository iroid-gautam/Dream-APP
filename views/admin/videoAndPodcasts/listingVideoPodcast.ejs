<%- include('../layouts/header') %>

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Videos & Podcasts</h1>

    <!-- DataTales Example -->
    <div class="card shadow mb-3">
        <div class="card-header py-4">
            <!-- <h6 class="m-0 font-weight-bold text-primary">DataTables Example</h6> -->
            <% if(success !='' ){ %>
                <div class="alert alert-success" id="success">
                    <%= success %>
                </div>
                <% } %>
                    <% if(error !='' ){ %>
                        <div class="alert alert-danger" id="error">
                            <%= error %>
                        </div>
                        <% } %>
                            <div style="display: flex; justify-content: right; margin-right: 20px;">
                                <a href="/admin/videopodcasts/addPage" type="button" class="btn btn-primary">Add
                                    Videos & Podcasts </a>
                            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="videosorpodcasts" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>No.</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Videos & Podcasts</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>


                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <script src="/admin/vendor/jquery/jquery.min.js"></script>

    <script>
        $("#success").show().delay(2000).fadeOut();
        $("#error").show().delay(2000).fadeOut();
        $('#pageTitle').text('Video & Podcasts')
        $('#select-vp').addClass('active', 'true')

        $(document).ready(function () {
            $('#videosorpodcasts').DataTable({
                paging: true,
                responsive: true,
                searching: true,
                processing: true,
                serverSide: true,
                ordering: false,
                ajax: {
                    url: "<%= process.env.APP_URL_ADMIN %>/admin/videopodcasts/listing",
                    type: "GET",
                },
                columns: [
                    {
                        "data": "id",
                        "render": function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    {
                        "data": "title",
                        "render": function (data, type, row) {
                            return data != "" ? data : null
                        },
                        "width": "20%"
                    },
                    {
                        "data": "description",
                        "render": function (data, type, row) {
                            return data != "" ? data.length > 150 ? data.substring(0, 150) + "......" : data : null
                        },
                        "width": "40%"
                    },
                    {
                        "data": "videoPodcast",
                        "render": function (data) {
                            return data == null ? `<img src="${'<%= process.env.APP_URL_ADMIN %>'}/admin/img/background.jpg" height="70" style="border-radius: 20px;" />` : `<video width="350" height="140" controls>
                                                                    <source src="${'<%= process.env.APP_URL_ADMIN %>'}/${data}">
                                                                </video>`
                        }
                    },
                    {
                        "data": null,
                        "render": function (data) {
                            // <a href="/admin/ourinsights/updatePage/${data._id}" style="border-radius:11px; padding: 6px 10px;" class="btn btn-success"><i class="fas fa-pencil-alt"></i></a> 
                            return ` <a href="/admin/videopodcasts/deleteVP/${data._id}" onclick="deleteRecord(event)" style="border-radius:11px; padding: 6px 11px;" class="btn btn-danger"><i class="fas fa-trash"></i></a>`
                        },
                        "width": "9%"
                    },
                ],
            });
        });



        function deleteRecord(ev) {
            ev.preventDefault();
            var id = ev.currentTarget.getAttribute('href');
            // console.log(id);
            Swal.fire({
                title: 'Are you sure you want to delete this Video/Podcast ?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it !!'
            })
                .then((willDelete) => {
                    if (willDelete.isConfirmed) {
                        $.ajax({
                            url: id,
                            type: 'GET',
                            success: function (d) {
                                Swal.fire(
                                    'Deleted!',
                                    'Videos & Podcasts deleted successfully',
                                    'success'
                                )
                                $('#videosorpodcasts').DataTable().ajax.reload();
                            }
                        });
                    }
                }).catch(err => console.log(err))
        }
    </script>

    <%- include('../layouts/footer') %>