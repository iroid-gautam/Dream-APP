<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>reset-password</title>
  </head>

  <body>
    <table
      style="
        font-family: 'general-sans', system-ui;
        margin-left: auto;
        margin-right: auto;
        width: 560px;
      "
    >
      <td style="filter: drop-shadow(1px 1px 1px #ffff)">
        <img src="<%=logo%>" alt="" width="50px" height="50px" />
      </td>
      <tr>
        <td style="font-size: 14px">
          <h1 style="margin-bottom: 0">Reset your password? 🔒</h1>
        </td>
      </tr>
      <tr>
        <td style="font-size: 16px; font-weight: 650">
          <p style="margin-bottom: 0; margin-top: 10px">
            No worries – it happens!
          </p>
        </td>
      </tr>
      <tr>
        <td style="font-size: 16px; font-weight: 650">
          <p style="margin-bottom: 0">
            Simply click on the button below to choose a new one.
          </p>
        </td>
      </tr>
      <tr>
        <td style="text-align: center; padding: 25px 0">
          <a
            href="<%= url %>"
            style="
              background: #f5b8c9;
              border-radius: 6px;
              font-weight: 750;
              text-decoration: none;
              color: #1a1c1f;
              padding: 10px 55px;
              font-size: 16px;
              text-transform: uppercase;
            "
          >
            reset password
          </a>
        </td>
      </tr>
      <tr>
        <td style="font-size: 15px; font-weight: 600">
          <a
            href="<%= url %>"
            style="
              font-style: normal;
              font-weight: 700;
              font-size: 15px;
              line-height: 22px;
              text-decoration: underline;
              color: #0f7a5b;
            "
          >
            <%= url %>
          </a>
          <br />
          <span>
            Or copy and paste the above link into a browser if it is not
            clickable</span
          >
        </td>
      </tr>
      <tr>
        <td style="font-size: 15px; font-weight: 600">
          <p style="margin-bottom: 0">Many thanks</p>
          <p style="margin-top: 0; font-weight: 650">
            Team Kick Fear In Butt App
          </p>
        </td>
      </tr>
    </table>
  </body>
  
</html>
